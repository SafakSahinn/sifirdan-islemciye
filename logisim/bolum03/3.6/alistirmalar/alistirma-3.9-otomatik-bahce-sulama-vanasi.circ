      <a name="output" val="true"/>
      <a name="labelloc" val="east"/>
    </comp>
    <comp lib="6" loc="(585,281)" name="Text">
      <a name="text" val="F(A, B, C, D) = Σ(1,3,4,6,9,11,12,13,14,15)"/>
      <a name="font" val="SansSerif bold 14"/>
    </comp>
    <comp lib="6" loc="(374,75)" name="Text">
      <a name="text" val="Diğer tüm durumlarda vana açılır (&#119865; = 1). Minimal SOP ve POS değerlerini bulup, devrelerini tasarlayalım."/>
      <a name="font" val="SansSerif bold 11"/>
    </comp>
    <comp lib="1" loc="(280,230)" name="AND Gate">
      <a name="inputs" val="2"/>
      <a name="label" val="B'D"/>
      <a name="labelfont" val="SansSerif bold 12"/>
    </comp>
    <comp lib="6" loc="(647,35)" name="Text">
      <a name="text" val="Problem: Otomatik bir bahçe sulama vanası 4 sensör girişiyle çalışıyor: &#119860; (gece modu aktif), &#119861; (toprak nem sensörü, 1=toprak kuru), &#119862; (yağmur sensörü), &#119863; (zamanlayıcı te tiklendi). Vana şu iki durumda kapalı kalır (&#119865; = 0):"/>
      <a name="font" val="SansSerif bold 11"/>
    </comp>
    <comp lib="1" loc="(280,370)" name="AND Gate">
      <a name="inputs" val="2"/>
      <a name="label" val="AB"/>
      <a name="labelfont" val="SansSerif bold 12"/>
    </comp>
    <comp lib="6" loc="(546,501)" name="Text">
      <a name="text" val="F(A, B, C, D) = π(0,2,5,7,8,10)"/>
      <a name="font" val="SansSerif bold 14"/>
    </comp>
    <comp lib="1" loc="(190,190)" name="NOT Gate">
      <a name="facing" val="south"/>
    </comp>
    <comp lib="6" loc="(523,525)" name="Text">
      <a name="text" val="F = (B + D)(A + B' + D')"/>
      <a name="font" val="SansSerif bold 14"/>
    </comp>
    <comp lib="1" loc="(280,300)" name="AND Gate">
      <a name="inputs" val="2"/>
      <a name="label" val="BD'"/>
