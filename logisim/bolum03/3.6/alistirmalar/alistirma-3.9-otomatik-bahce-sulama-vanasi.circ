    <comp lib="6" loc="(761,55)" name="Text">
      <a name="text" val="ne toprak kuru ne de zamanlayıcı tetik lenmişse (&#119861; = 0,&#119863; = 0, sulamaya hiç gerek yok), ya da gündüz vakti (&#119860; = 0) toprak kuru ve zamanlayıcı tetiklenmiş olsa bile (&#119861; = 1,&#119863; = 1; öğle güneşinde sulama yaprak yanığına yol açabileceğinden engellenir)."/>
      <a name="font" val="SansSerif bold 11"/>
    </comp>
