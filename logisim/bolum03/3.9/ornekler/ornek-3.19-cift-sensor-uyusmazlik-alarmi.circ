  <circuit name="ornek-3.19-cift-sensor-uyusmazlik-alarmi">
    <a name="circuit" val="ornek-3.19-cift-sensor-uyusmazlik-alarmi"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif plain 12"/>
    <wire from="(50,140)" to="(50,210)"/>
    <wire from="(50,210)" to="(50,280)"/>
    <wire from="(90,250)" to="(140,250)"/>
    <wire from="(90,250)" to="(90,280)"/>
