    <comp lib="6" loc="(158,60)" name="Text">
      <a name="text" val="F fonksiyonunu veren devreyi tasarlayalım."/>
      <a name="font" val="SansSerif bold 11"/>
    </comp>
    <comp lib="6" loc="(678,21)" name="Text">
      <a name="text" val="Problem: Bir güvenlik sisteminde aynı koridoru izleyen iki bağımsız hareket sensörü var: &#119860; ve &#119861;. Sistem tasarımına göre bu iki sensör her zaman birlikte hareket etmelidir; ikisi de aynı anda tetiklenmeli ya da ikisi de sakin kalmalıdır."/>
      <a name="font" val="SansSerif bold 11"/>
    </comp>
    <comp lib="6" loc="(594,40)" name="Text">
      <a name="text" val="Yalnızca birinin tetiklenmesi, sensörlerden birinde bir arıza olduğunu ya da izleme alanına yalnızca kısmi bir müdahale olduğunu gösterir. Sistem bu uyuşmazlığı yakalayıp bir alarm sinyali (&#119865; = 1) üretsin."/>
      <a name="font" val="SansSerif bold 11"/>
    </comp>
    <comp lib="0" loc="(50,140)" name="Pin">
      <a name="facing" val="south"/>
      <a name="tristate" val="false"/>
      <a name="label" val="A"/>
      <a name="labelloc" val="north"/>
      <a name="labelfont" val="SansSerif bold 20"/>
    </comp>
    <comp lib="6" loc="(271,235)" name="Text">
      <a name="text" val="F = A ⊕ B"/>
      <a name="font" val="SansSerif bold 14"/>
    </comp>
    <comp lib="0" loc="(90,140)" name="Pin">
      <a name="facing" val="south"/>
      <a name="tristate" val="false"/>
      <a name="label" val="B"/>
      <a name="labelloc" val="north"/>
      <a name="labelfont" val="SansSerif bold 20"/>
    </comp>
    <comp lib="0" loc="(210,230)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="labelloc" val="east"/>
    </comp>
    <comp lib="6" loc="(698,164)" name="Text">
      <a name="text" val="Çözüm: F = 1 olması gereken tek durum, A ile B’nin farklı değer aldığı durumdur; bu tam olarak XOR’un tanımıdır."/>
      <a name="font" val="SansSerif bold 13"/>
    </comp>
    <comp lib="1" loc="(200,230)" name="XOR Gate">
      <a name="inputs" val="2"/>
      <a name="label" val="F"/>
      <a name="labelfont" val="SansSerif bold 20"/>
    </comp>
