    <comp lib="6" loc="(637,40)" name="Text">
      <a name="text" val="Kalite kontrol sistemi bunu doğrulamak için &#119860;, &#119861;, &#119862;, &#119863; arasından 1 değerini alanların sayısını kontrol eder: bu sayı tek ise (yani 1 ya da 3 istasyon aktifse) tutarsız bir durum algılanmış demektir ve bir uyarı (&#119865; = 1) üretilir."/>
      <a name="font" val="SansSerif bold 11"/>
    </comp>
    <comp lib="0" loc="(130,140)" name="Pin">
      <a name="facing" val="south"/>
      <a name="tristate" val="false"/>
      <a name="label" val="C"/>
      <a name="labelloc" val="north"/>
      <a name="labelfont" val="SansSerif bold 20"/>
    </comp>
    <comp lib="6" loc="(698,164)" name="Text">
      <a name="text" val="Çözüm: ”Tek sayıda giriş 1” tanımı, doğrudan 4-değişkenli tek sayı fonksiyonuna karşılık gelir."/>
      <a name="font" val="SansSerif bold 13"/>
    </comp>
    <comp lib="6" loc="(571,275)" name="Text">
      <a name="text" val="F = A ⊕ B ⊕ C ⊕ D"/>
      <a name="font" val="SansSerif bold 14"/>
    </comp>
    <comp lib="6" loc="(575,21)" name="Text">
      <a name="text" val="Problem: Bir montaj hattında 4 istasyon, kendi görevini tamamladığında birer sinyal (&#119860;, &#119861;, &#119862;, &#119863;) gönderir. Hat tasarımı gereği normal çalışmada bu sinyallerden çift sayıda tanesi aynı anda aktif olur."/>
      <a name="font" val="SansSerif bold 11"/>
    </comp>
    <comp lib="0" loc="(50,140)" name="Pin">
      <a name="facing" val="south"/>
      <a name="tristate" val="false"/>
      <a name="label" val="A"/>
      <a name="labelloc" val="north"/>
      <a name="labelfont" val="SansSerif bold 20"/>
    </comp>
    <comp lib="1" loc="(370,250)" name="XOR Gate">
      <a name="inputs" val="2"/>
      <a name="label" val="A⊕B⊕C"/>
      <a name="labelfont" val="SansSerif plain 10"/>
    </comp>
    <comp lib="0" loc="(170,140)" name="Pin">
      <a name="facing" val="south"/>
      <a name="tristate" val="false"/>
      <a name="label" val="D"/>
      <a name="labelloc" val="north"/>
      <a name="labelfont" val="SansSerif bold 20"/>
    </comp>
    <comp lib="6" loc="(207,60)" name="Text">
      <a name="text" val="F ’i kademeli XOR cinsinden ifade edip devresini tasarlayalım."/>
      <a name="font" val="SansSerif bold 11"/>
    </comp>
    <comp lib="1" loc="(470,270)" name="XOR Gate">
