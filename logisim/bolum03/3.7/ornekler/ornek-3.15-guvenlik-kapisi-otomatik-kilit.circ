    <comp lib="6" loc="(709,21)" name="Text">
      <a name="text" val="Problem: Bir güvenlik kapısının otomatik kilit açma devresi 4 sinyal okur: &#119860; = yan gın alarmı aktif, &#119861; = gece modu, &#119862; = bakım modu, &#119863; = manuel açma butonuna basıldı. Devre kilidi iki durumda açar (&#119865; = 1): yangın alarmı aktif olduğunda (&#119860; = 1), ya da"/>
      <a name="font" val="SansSerif bold 11"/>
    </comp>
    <comp lib="6" loc="(635,211)" name="Text">
      <a name="text" val="F(A, B, C, D) = Σ(1,5,8,9,12,13), &#119889;(A, B, C, D)=Σ(10,11,14,15)"/>
      <a name="font" val="SansSerif bold 14"/>
    </comp>
    <comp lib="0" loc="(170,140)" name="Pin">
      <a name="facing" val="south"/>
      <a name="tristate" val="false"/>
      <a name="label" val="D"/>
      <a name="labelloc" val="north"/>
      <a name="labelfont" val="SansSerif bold 20"/>
    </comp>
    <comp lib="6" loc="(212,80)" name="Text">
      <a name="text" val="Minimal SOP ve POS değerlerini bulup, devrelerini tasarlayalım."/>
      <a name="font" val="SansSerif bold 11"/>
    </comp>
    <comp lib="6" loc="(504,40)" name="Text">
      <a name="text" val="bakım modunda değilken manuel açma butonuna basıldığında (&#119862; = 0 ve &#119863; = 1). Gece modunun (&#119861;) bu karara hiçbir etkisi yoktur; kilit mantığı gece ile gündüzü ayırt etmez."/>
      <a name="font" val="SansSerif bold 11"/>
    </comp>
    <comp lib="6" loc="(475,236)" name="Text">
      <a name="text" val="F = A + C'D"/>
      <a name="font" val="SansSerif bold 14"/>
    </comp>
    <comp lib="0" loc="(410,370)" name="Pin">
