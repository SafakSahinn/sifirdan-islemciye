    <comp lib="6" loc="(653,41)" name="Text">
      <a name="text" val="ya da sıcaklık ile nem ikisi birden yüksek olduğunda (&#119860; = 1 ve &#119861; = 1). Bakım sırasında (&#119863; = 1) teknisyen gaz hattını önceden kapattığından, gaz sızıntısı sensörünün (&#119862; = 1) aynı anda aktif olduğu bir durum hiç kaydedilmemiştir;"/>
      <a name="font" val="SansSerif bold 11"/>
    </comp>
